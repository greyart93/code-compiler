generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String?
  password  String?
  bio       String?
  image     String?
  createdAt DateTime @default(now())

  snippets  Snippet[]
  tutorials Tutorial[]
  comments  Comment[]
  likes     Like[]
  questions Question[]
  answers   Answer[]
  votes     Vote[]

  courseProgress CourseProgress[]
  activityDays  ActivityDay[]

  notes          Note[]
  interviewSessions InterviewSession[]
  codeAttempts      CodeAttempt[]
  streak            Streak?

  liveInterviewsHosted LiveInterviewRoom[] @relation("LiveInterviewInterviewer")
  liveInterviewsTaken  LiveInterviewRoom[] @relation("LiveInterviewCandidate")
}

/** Daily activity log — one row per day the user does anything learning-related.
 *  Streak = consecutive days with an activity row, recomputed on write. */
model ActivityDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime // UTC midnight of the activity day
  kind      String   // "lesson" | "interview" | "code-test" | "note"

  @@unique([userId, day])
  @@index([userId, day])
}

/** Denormalized streak cache, updated whenever an ActivityDay is written. */
model Streak {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current   Int      @default(0) // consecutive days including today (or yesterday if today has none yet)
  longest   Int      @default(0)
  lastDay   DateTime?
}

/** A note a user saves while learning (from a lesson or standalone). */
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  courseSlug String?
  lessonId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/** One IRIS interview session (tech interview or english warmup). */
model InterviewSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "tech" | "english"
  topic     String   // e.g. "react", "nextjs", or "english"
  questions Json     // [{ q, a, eval: { verdict, score, feedback } }]
  score     Int?     // 0-100 average
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/** A leetcode-style code test attempt (passed = all tests green). */
/** A live interviewer↔candidate interview room. */
model LiveInterviewRoom {
  id          String   @id @default(cuid())
  code        String   @unique // short join code, e.g. "7F3K"
  interviewerId String
  interviewer User     @relation("LiveInterviewInterviewer", fields: [interviewerId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   User?    @relation("LiveInterviewCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  phase       String   @default("lobby") // lobby | intro | theory | coding | open | done
  cursor      Int      @default(0) // index of the current question within the phase
  questions   Json     // [{ kind: "intro"|"theory"|"code"|"open", q, snippetId? }]
  codeState   String?  // shared code buffer text
  codeLang    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals     Signal[]

  @@index([interviewerId])
}

/** Ephemeral per-room events (join/leave, editor edits, cursor moves, whiteboard strokes). */
model Signal {
  id        BigInt   @id @default(autoincrement())
  roomId    String
  sender    String   @default("")
  type      String   // chat, edit, cursor, stroke, clear, phase, hello, bye, end
  payload   String
  createdAt DateTime @default(now())

  room      LiveInterviewRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model CodeAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  passed    Boolean
  score     Int      @default(0) // tests passed / total * 100
  createdAt DateTime @default(now())

  @@index([userId, problemId])
  @@index([userId, createdAt])
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  completedAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model Snippet {
  id        String   @id @default(cuid())
  title     String
  language  String
  code      String
  input     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes    Like[]
  comments Comment[]

  @@index([userId])
  @@index([isPublic, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippetId String
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([userId, snippetId])
  @@index([snippetId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippetId String
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([snippetId])
}

model Tutorial {
  id        String   @id @default(cuid())
  title     String
  content   String
  language  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Question {
  id        String   @id @default(cuid())
  title     String
  body      String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers Answer[]
  votes   Vote[]

  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  votes Vote[]

  @@index([questionId])
}

model Vote {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, answerId])
  @@index([questionId])
  @@index([answerId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
