# Neon Postgres connection string (each app gets its own database on the project)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session JWTs - set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# glot.io API token for the code execution API
GLOT_API_TOKEN=""
