[TEMPLATE]
# Neon Postgres connection string (each app gets its own database on the project)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session JWTs - set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# glot.io API token for the code execution API
GLOT_API_TOKEN=""

# ── IRIS AI grading (via any OpenAI-compatible provider) ────────────────
# Default provider: Groq — free tier, no credit card, no training on your data.
# 1. Create a key at https://console.groq.com  (starts with "gsk_...")
# 2. Paste it into your .env.local as OPENAI_API_KEY (GROQ_API_KEY also works);
#    model default: openai/gpt-oss-120b
# Other providers — just change OPENAI_BASE_URL + OPENAI_MODEL:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/  (gemini-*-flash)
#   xAI:    https://api.x.ai/v1                                       (grok-*, more expensive)
#   OpenAI: https://api.openai.com/v1                                 (gpt-4o-mini)
# OPENAI_API_KEY="gsk_..."
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_MODEL="openai/gpt-oss-120b"

# ── IRIS voice (Fish Audio TTS) ────────────────────────────────────────
# API key from https://fish.audio (dashboard → API keys, starts with "sk-fish-...")
# If Fish has no credit (HTTP 402) IRIS automatically uses a keyless female
# fallback voice, then the browser's best female speechSynthesis voice.
FISH_AUDIO=""
# Voice used for IRIS's speech: your own "Shorekeeper" Fish Audio model reference_id
FISH_VOICE_ID="c3745ad70c2a48bc9c7f6123c69d62c0"

# IRIS speech-to-text (the answer that gets graded).
# GROQ_API_KEY is the primary provider (whisper-large-v3-turbo, fast + accurate).
# OPENAI_API_KEY is used as a secondary Whisper provider if Groq fails.
# Browser SpeechRecognition is only the live preview; it is never trusted alone.
GROQ_API_KEY="gsk_..."

GOOGLE_CLIENT_ID=""

GOOGLE_CLIENT_SECRET=""
